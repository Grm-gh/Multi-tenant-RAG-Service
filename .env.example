DATABASE_URL=postgresql://rag:rag@db:5432/rag
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-to-a-long-random-string
UPLOAD_DIR=/data/uploads
# Leave ANTHROPIC_API_KEY empty to run without an LLM (returns top passages instead of a generated answer)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# st = sentence-transformers (real), hash = deterministic fake (tests/CI)
EMBEDDING_BACKEND=st
# ce = cross-encoder reranker, none = skip
RERANK_BACKEND=ce
RATE_CAPACITY=20
RATE_REFILL_PER_SEC=0.5
CHUNK_WORDS=350
CHUNK_OVERLAP=60
